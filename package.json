{
  "name": "letta-a2a-server",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Expose existing Letta agents through bidirectional A2A communication.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=24.19.0" },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "bun test tests",
    "start": "node dist/main.js",
    "prepare": "effect-tsgo patch --typescript --no-oxlint"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.1.0",
    "@effect/platform-node": "4.0.0",
    "@letta-ai/letta-agent-sdk": ">=0.8.28",
    "effect": "4.0.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.48.0",
    "@types/bun": "1.3.4",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "7.0.2"
  }
}
